{
  "name": "readable-uuid-dev",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "cargo xtask npm-build",
    "test": "tsc --noEmit && node --test test/*.ts",
    "bench": "node bench/compare.ts",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run fmt:check && pnpm run lint",
    "pack": "cargo xtask npm-pack",
    "publish:check": "cargo xtask npm-publish --dry-run",
    "release": "cargo xtask npm-publish"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.4",
    "prettier": "3.9.8",
    "eslint": "10.11.0",
    "@eslint/js": "10.0.1",
    "globals": "17.12.0",
    "niceware": "4.0.0",
    "@scure/bip39": "2.4.0",
    "@types/node": "24.13.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
